# ==================== OneHubX Movies ====================

# 必填：私人家庭站访问密码
PASSWORD=change-me

# 强烈建议：独立会话签名密钥（openssl rand -hex 32）
# PROXY_SECRET=

# HTTPS 反代后通常可自动识别；必要时显式强制 Secure Cookie
# COOKIE_SECURE=true

# SQLite / 海报缓存等持久化目录
ONEHUBX_DATA_DIR=/data

# -------------------- 115（Phase 1） --------------------
# 当前 Phase 1 使用 OpenStrm 兼容的只读 115 Cookie 接口流程。
# Cookie 属于敏感凭据，只放服务器环境变量，不写进仓库/前端。
ONEHUBX_115_COOKIE=

# 只扫描指定媒体目录；支持 JSON 数组，推荐这种写法
ONEHUBX_115_MEDIA_DIRS=["/电影","/电视剧","/纪录片","/动漫"]

# 风控保守默认：1 并发、每秒最多 1 次请求。除非有明确验证，不建议调高。
ONEHUBX_115_MAX_CONCURRENT=1
ONEHUBX_115_MAX_RPS=1
ONEHUBX_115_RETRIES=2
ONEHUBX_115_TIMEOUT_MS=12000
ONEHUBX_SYNC_MAX_FILES=20000
# ONEHUBX_115_USER_AGENT=

# -------------------- TMDB（下一批接入） --------------------
# TMDB_API_TOKEN=
# TMDB_LANGUAGE=zh-CN

# -------------------- LibreTV 原有能力 --------------------
REQUEST_TIMEOUT=8000
MAX_RETRIES=1
# 60S_API_BASE=https://60s.viki.moe
DEBUG=false
