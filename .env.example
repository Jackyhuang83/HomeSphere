# HomeSphere
PASSWORD=change-me

# 可选：会话签名密钥；生产环境建议显式设置
# PROXY_SECRET=

# HTTPS 部署建议 true；不设置时按反向代理协议自动判断
# COOKIE_SECURE=true

# -------------------------
# 私人片库（生产推荐）
# -------------------------
# 默认模式：HomeSphere 只读 STRM，本身不保存 115 凭据
HOMESPHERE_LIBRARY_MODE=strm

# 容器内只读 STRM 根目录
HOMESPHERE_STRM_ROOT=/media

# 可选：限制 .strm 中允许跳转的 Bridge 主机，逗号分隔
# 强烈建议生产环境配置
# HOMESPHERE_STRM_ALLOWED_HOSTS=media.example.com

# Docker Compose 宿主机 STRM 目录；不会传入容器环境
HOMESPHERE_STRM_PATH=./media

# 本地同步保护阈值
HOMESPHERE_SYNC_MAX_ENTRIES=30000
HOMESPHERE_SYNC_MAX_DIRS=5000

# SQLite 数据目录；Docker 固定 /data
# HOMESPHERE_DATA_DIR=/data

# -------------------------
# 115 Direct（高级兼容模式）
# -------------------------
# 只有显式设置 HOMESPHERE_LIBRARY_MODE=direct115 才会启用。
# 正式交付推荐保持 strm，让 115 凭据只存在 Media Bridge。
# HOMESPHERE_115_COOKIE=
# HOMESPHERE_115_MEDIA_DIRS=["/电影","/电视剧"]
HOMESPHERE_115_MIN_INTERVAL_MS=500
HOMESPHERE_115_TIMEOUT_MS=15000

# -------------------------
# TMDB 元数据
# -------------------------
# TMDB API Read Access Token（Bearer）
# TMDB_API_TOKEN=
TMDB_LANGUAGE=zh-CN

# -------------------------
# 推荐榜单 / IPTV
# -------------------------
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视热榜 API
# 60S_API_BASE=https://60s.viki.moe

# 可选：预置 IPTV M3U / EPG
# DEFAULT_LIVE_SOURCES=[{"name":"家庭直播","url":"https://example.com/list.m3u","epg":"https://example.com/epg.xml.gz"}]

# 可选：自建内网 IPTV 时开启
# LIVE_ALLOW_PRIVATE=1

# 可选：覆盖 Docker 镜像
# HOMESPHERE_IMAGE=ghcr.io/jackyhuang83/homesphere:latest

DEBUG=false
