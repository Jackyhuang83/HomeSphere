# HomeSphere
PASSWORD=change-me

# 可选：生产环境建议设置独立 Session 签名密钥
# PROXY_SECRET=

# HTTPS 部署建议 true；不设置时按反向代理协议自动判断
# COOKIE_SECURE=true

# -------------------------
# STRM 片库
# -------------------------
HOMESPHERE_STRM_ROOT=/media
HOMESPHERE_STRM_PATH=./media

# Media Bridge 内网主机 allowlist，逗号分隔
HOMESPHERE_STRM_ALLOWED_HOSTS=media-bridge

# Bridge 解析保护（保守档）
HOMESPHERE_BRIDGE_TIMEOUT_MS=12000
HOMESPHERE_BRIDGE_MAX_REDIRECTS=3
HOMESPHERE_BRIDGE_MIN_INTERVAL_MS=1000
HOMESPHERE_BRIDGE_CACHE_TTL_MS=60000
HOMESPHERE_BRIDGE_CIRCUIT_MS=60000

# STRM 扫描保护
HOMESPHERE_SYNC_MAX_ENTRIES=30000
HOMESPHERE_SYNC_MAX_DIRS=5000

# SQLite 数据目录；Docker 固定 /data
# HOMESPHERE_DATA_DIR=/data

# -------------------------
# TMDB 元数据
# -------------------------
# TMDB_API_TOKEN=
TMDB_LANGUAGE=zh-CN

# -------------------------
# 推荐榜单 / IPTV
# -------------------------
REQUEST_TIMEOUT=8000
MAX_RETRIES=1
# SIXTYS_API_BASE=https://60s.viki.moe
# DEFAULT_LIVE_SOURCES=[{"name":"家庭直播","url":"https://example.com/list.m3u","epg":"https://example.com/epg.xml.gz"}]
# LIVE_ALLOW_PRIVATE=1

# 可选：覆盖 Docker 镜像
# HOMESPHERE_IMAGE=ghcr.io/jackyhuang83/homesphere:latest

DEBUG=false
