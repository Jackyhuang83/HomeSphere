# HomeSphere
PASSWORD=change-me

# 可选：会话签名密钥；生产环境建议显式设置
# PROXY_SECRET=

# HTTPS 部署建议 true；不设置时按反向代理协议自动判断
# COOKIE_SECURE=true

# -------------------------
# 115 私人片库
# -------------------------
# 敏感信息：仅放服务器 .env，绝对不要提交到 GitHub
# HOMESPHERE_115_COOKIE=

# 必须指定具体影视目录；支持 JSON 数组或逗号分隔
# 禁止设置为 /，避免误扫整个 115 网盘
# HOMESPHERE_115_MEDIA_DIRS=["/电影","/电视剧"]

# 115 请求节奏：默认单并发，每次请求至少间隔 500ms
HOMESPHERE_115_MIN_INTERVAL_MS=500
HOMESPHERE_115_TIMEOUT_MS=15000

# 单次手动同步保护阈值
HOMESPHERE_SYNC_MAX_ENTRIES=30000
HOMESPHERE_SYNC_MAX_DIRS=5000

# Docker 持久化目录；本地开发未配置时默认 ./.data
# HOMESPHERE_DATA_DIR=/data

# -------------------------
# 推荐榜单 / IPTV
# -------------------------
REQUEST_TIMEOUT=8000
MAX_RETRIES=1

# 可选：影视热榜 API
# 60S_API_BASE=https://60s.viki.moe

# 可选：预置 IPTV M3U / EPG
# DEFAULT_LIVE_SOURCES=[{"name":"家庭直播","url":"https://example.com/list.m3u","epg":"https://example.com/epg.xml.gz"}]

# 可选：自建内网 IPTV 时开启
# LIVE_ALLOW_PRIVATE=1

# 可选：覆盖 Docker 镜像
# HOMESPHERE_IMAGE=ghcr.io/jackyhuang83/homesphere:latest

DEBUG=false
